# Writer model (Claude). Required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Jev (TypeSafe System One). Optional: without it the LLM classifies and every reply is held for approval.
TYPESAFE_API_KEY=

# Supabase (service role, server-only). Required for the ManyChat bridge, links, approvals.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this deployment, used for tracked links (no trailing slash).
APP_URL=http://localhost:3000

# Gates the simulator API and /approvals. Required in production.
ADMIN_PASSWORD=
